import numpy as np


def f(x):
    return (x + 1) / (x + 2)


a, b = 0.0, 1.0
eps1, eps2 = 1e-2, 1e-3

n = 5
while True:
    h = (b - a) / n
    x_mid = np.linspace(a + h / 2, b - h / 2, n)
    I_p1 = h * np.sum(f(x_mid))

    n2 = 2 * n
    h2 = (b - a) / n2
    x_mid2 = np.linspace(a + h2 / 2, b - h2 / 2, n2)
    I_p2 = h2 * np.sum(f(x_mid2))

    if abs(I_p2 - I_p1) / 3 <= eps1:
        I_rect = I_p2
        break
    n = n2

print(f"2.1. а) Прямокутники: I ≈ {I_rect:.4f} (n = {n})")

n = 5
while True:
    h = (b - a) / n
    x = np.linspace(a, b, n + 1)
    y = f(x)
    I_t1 = h * (0.5 * y[0] + 0.5 * y[-1] + np.sum(y[1:-1]))

    n2 = 2 * n
    h2 = (b - a) / n2
    x2 = np.linspace(a, b, n2 + 1)
    y2 = f(x2)
    I_t2 = h2 * (0.5 * y2[0] + 0.5 * y2[-1] + np.sum(y2[1:-1]))

    if abs(I_t2 - I_t1) / 3 <= eps2:
        I_trap = I_t2
        break
    n = n2

print(f"2.1. b) Трапеції: I ≈ {I_trap:.4f} (n = {n})")
